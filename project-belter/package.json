{
  "name": "project-belter",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Smartphone-first deterministic space-mining vertical slice for Project Belter.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:standalone && playwright test --workers=2",
    "test:e2e:update": "npm run build:standalone && playwright test --workers=2 --update-snapshots",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify": "npm run check && npm run test:e2e",
    "test:e2e:mobile": "playwright test --project=mobile-portrait",
    "test:e2e:desktop": "playwright test --project=desktop-landscape",
    "build:standalone": "npm run build && node scripts/build-standalone.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  }
}
